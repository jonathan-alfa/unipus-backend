-- -----------------------------------------------------
-- loans
-- -----------------------------------------------------
CREATE TABLE loans (
  id           INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  user_id      INT NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
  status       VARCHAR(30) NOT NULL DEFAULT 'pending' REFERENCES loan_statuses(code),
  approved_by  INT REFERENCES users(id) ON DELETE SET NULL,
  approved_at  TIMESTAMPTZ,
  loan_date    DATE,
  due_date     DATE,
  returned_at  TIMESTAMPTZ,
  received_by  INT REFERENCES users(id) ON DELETE SET NULL,
  notes        TEXT,
  created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),            -- waktu pengajuan peminjaman
  updated_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  CONSTRAINT loans_date_chk CHECK (due_date IS NULL OR loan_date IS NULL OR due_date >= loan_date)
);

CREATE INDEX loans_user_idx   ON loans (user_id);
CREATE INDEX loans_status_idx ON loans (status);
CREATE INDEX loans_due_idx    ON loans (due_date);

CREATE TRIGGER loans_set_updated_at
  BEFORE UPDATE ON loans
  FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- -----------------------------------------------------
-- loan_items
-- -----------------------------------------------------
CREATE TABLE loan_items (
  id            INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  loan_id       INT NOT NULL REFERENCES loans(id) ON DELETE CASCADE,
  book_id       INT NOT NULL REFERENCES books(id) ON DELETE RESTRICT,
  book_copy_id  INT REFERENCES book_copies(id) ON DELETE RESTRICT, -- diisi saat admin approve
  created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  UNIQUE (loan_id, book_id)
);

CREATE INDEX loan_items_book_idx      ON loan_items (book_id);
CREATE INDEX loan_items_book_copy_idx ON loan_items (book_copy_id);

-- -----------------------------------------------------
-- loan_status_histories
-- -----------------------------------------------------
CREATE TABLE loan_status_histories (
  id           INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  loan_id      INT NOT NULL REFERENCES loans(id) ON DELETE CASCADE,
  from_status  VARCHAR(30) REFERENCES loan_statuses(code),   -- NULL = status awal
  to_status    VARCHAR(30) NOT NULL REFERENCES loan_statuses(code),
  changed_by   INT REFERENCES users(id) ON DELETE SET NULL,
  note         TEXT,
  created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX loan_status_histories_loan_idx ON loan_status_histories (loan_id);

-- -----------------------------------------------------
-- library_settings
-- -----------------------------------------------------
CREATE TABLE library_settings (
  key          VARCHAR(100) PRIMARY KEY,
  value        VARCHAR(500) NOT NULL,
  description  TEXT,
  updated_by   INT REFERENCES users(id) ON DELETE SET NULL,
  updated_at   TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TRIGGER library_settings_set_updated_at
  BEFORE UPDATE ON library_settings
  FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- -----------------------------------------------------
-- notifications
-- -----------------------------------------------------
CREATE TABLE notifications (
  id          INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  user_id     INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  loan_id     INT REFERENCES loans(id) ON DELETE CASCADE,
  title       VARCHAR(255) NOT NULL,
  message     TEXT NOT NULL,
  read_at     TIMESTAMPTZ,                                    -- NULL = unread
  created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX notifications_user_unread_idx ON notifications (user_id) WHERE read_at IS NULL;

-- -----------------------------------------------------
-- activity_logs
-- -----------------------------------------------------
CREATE TABLE activity_logs (
  id           INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  user_id      INT REFERENCES users(id) ON DELETE SET NULL,
  action       VARCHAR(100) NOT NULL,
  entity_type  VARCHAR(100),
  entity_id    INT,
  metadata     JSONB,
  created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX activity_logs_user_idx    ON activity_logs (user_id);
CREATE INDEX activity_logs_entity_idx  ON activity_logs (entity_type, entity_id);
CREATE INDEX activity_logs_created_idx ON activity_logs (created_at DESC);